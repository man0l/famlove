# ---- database ---------------------------------------------------------------
# Lakebase Postgres on Neon. Use the direct (non-pooler) string for migrations;
# the app itself talks over the serverless HTTP driver, which needs neither.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---- sessions ---------------------------------------------------------------
# 32+ random characters. `openssl rand -base64 32`
SESSION_SECRET=

# ---- site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://famlove.lol

# ---- identity: X OAuth 2.0 --------------------------------------------------
# One of the two proofs of humanity. Without these the site runs, but nobody
# can sign in except through ALLOW_DEV_LOGIN below.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://famlove.lol/api/auth/x/callback

# ---- money: Stripe ----------------------------------------------------------
# The DIY path. Gives you a card fingerprint — the sybil ledger — but leaves
# VAT registration, currency conversion and disputes on your desk.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 to let Stripe Tax calculate VAT for you (still your filing).
STRIPE_TAX=0
# Radar can't be configured from here; this is the crude version of the same
# idea. A speed bump, not a wall.
BLOCK_PREPAID_CARDS=0

# ---- money: merchant of record (recommended) --------------------------------
# Lemon Squeezy or Paddle become the legal seller: they register and remit EU
# VAT, absorb FX, and eat chargebacks. Counted honestly that is cheaper than
# raw Stripe at every jar size — and it deletes four compliance jobs from the
# build. The trade-off: no card fingerprint, so sybil defence leans harder on
# the X account gate.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---- optional ---------------------------------------------------------------
# Courtesy rate limits. The caps that matter are enforced by the database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The one email famlove sends: "N people showed up for you today".
RESEND_API_KEY=
EMAIL_FROM=famlove <hi@famlove.lol>

# Guards /api/cron/rollup. Vercel Cron sends it automatically.
CRON_SECRET=

# Local only: sign in as any handle without X keys. Refuses to work when
# NODE_ENV=production.
ALLOW_DEV_LOGIN=0
