# ---- database ---------------------------------------------------------------
# Lakebase Postgres on Neon. Use the direct (non-pooler) string for migrations;
# the app itself talks over the serverless HTTP driver, which needs neither.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---- sessions ---------------------------------------------------------------
# 32+ random characters. `openssl rand -base64 32`
SESSION_SECRET=

# ---- site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://famlove.lol

# ---- identity: X OAuth 2.0 --------------------------------------------------
# One of the two proofs of humanity. Without these the site runs, but nobody
# can sign in except through ALLOW_DEV_LOGIN below.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://famlove.lol/api/auth/x/callback

# ---- money: Stripe ----------------------------------------------------------
# The DIY path. Gives you a card fingerprint — the sybil ledger — but leaves
# VAT registration, currency conversion and disputes on your desk.
#
# On a LIVE key, checkout REFUSES to open without STRIPE_WEBHOOK_SECRET: the
# webhook is what credits the jar, and charging a card you cannot credit is
# the one failure worth blocking a sale over. `npm run golive <url>` checks
# this and everything else, and can create the webhook endpoint for you.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Tax. Defaults to ON whenever the key is live, because this sells
# digital credit to EU consumers. Prices are sent tax-INCLUSIVE so "$3 buys
# 300 cents" stays true at the till and VAT comes out of the margin.
# Set to 0 only if you are certain you have no EU consumer sales.
STRIPE_TAX=

# Optional. Leave blank to use your account's default tax code. Ask your
# accountant before overriding — this decides how the sale is taxed.
STRIPE_TAX_CODE=

# What buyers see on their statement, after your account's own descriptor.
STATEMENT_DESCRIPTOR_SUFFIX=FAMLOVE

# The currency prices are charged in. Anything other than your Stripe
# account's settlement currency costs ~1% in conversion.
CHECKOUT_CURRENCY=usd

# Radar can't be configured from here; this is the crude version of the same
# idea. A speed bump, not a wall.
BLOCK_PREPAID_CARDS=0

# ---- money: merchant of record (recommended) --------------------------------
# Lemon Squeezy or Paddle become the legal seller: they register and remit EU
# VAT, absorb FX, and eat chargebacks. Counted honestly that is cheaper than
# raw Stripe at every jar size — and it deletes four compliance jobs from the
# build. The trade-off: no card fingerprint, so sybil defence leans harder on
# the X account gate.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---- who is selling ---------------------------------------------------------
# Named on /legal/terms and /legal/privacy. EU consumer law requires a trader
# to identify itself properly before the sale, so `npm run golive` fails while
# the first three are missing.
LEGAL_ENTITY=
LEGAL_COMPANY_NUMBER=
LEGAL_VAT_NUMBER=
LEGAL_ADDRESS=
LEGAL_COUNTRY=Bulgaria
LEGAL_EMAIL=hello@famlove.lol
LEGAL_UPDATED=2026-08-26

# Show a "I agree to the Terms" tick-box at checkout. Requires the Terms URL
# set in Stripe → Settings → Checkout first, or session creation errors.
# The immediate-supply notice shows either way.
STRIPE_TOS_CONSENT=0

# ---- optional ---------------------------------------------------------------
# Courtesy rate limits. The caps that matter are enforced by the database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The one email famlove sends: "N people showed up for you today".
RESEND_API_KEY=
EMAIL_FROM=famlove <hi@famlove.lol>

# Guards /api/cron/rollup. Vercel Cron sends it automatically.
CRON_SECRET=

# Local only: sign in as any handle without X keys. Refuses to work when
# NODE_ENV=production.
ALLOW_DEV_LOGIN=0
