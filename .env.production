# Loaded by `next build` (NODE_ENV=production) and taking precedence over .env.
#
# NEXT_PUBLIC_* is inlined into the bundle at build time, so the value that
# matters is whichever one is present when `opennextjs-cloudflare build` runs —
# not the one wrangler.jsonc sets, which only ever applies at runtime, long
# after the string has been baked in.
#
# Getting this wrong is silent and expensive: a build carrying .env's localhost
# shipped og:image and og:url pointing at localhost, so every shared link
# rendered no card at all, X OAuth asked for a localhost redirect_uri, and
# Stripe sent people to localhost after paying. Nothing errors; it just stops
# working for everyone except the person running it locally.
NEXT_PUBLIC_SITE_URL=https://famlove.lol

# Google Analytics. NEXT_PUBLIC_*, so it is inlined at build time like the site
# URL above — setting it in wrangler.jsonc vars would do nothing. Left unset in
# .env so the tag never fires in local development.
NEXT_PUBLIC_GA_ID=G-QM77MBEWC2

# DataFast. Same build-time inlining rule as the two above. The default script
# identifies visitors with a cookie, so ConsentBanner only injects it once the
# visitor has allowed it.
NEXT_PUBLIC_DATAFAST_ID=dfid_VqIbxWX7Q0R0JjcdUByiQ
NEXT_PUBLIC_DATAFAST_DOMAIN=famlove.lol

# X (Twitter) Ads. NEXT_PUBLIC_*, so inlined at BUILD time — setting these in
# wrangler.jsonc vars would do nothing. The pixel is an advertising tag and
# sets a cookie, so ConsentBanner injects it only after the visitor presses
# Allow. The event ID is X's name for the "Project listed" (Lead) conversion;
# editing that event in Ads Manager mints a new ID and the old one silently
# stops recording rather than erroring.
NEXT_PUBLIC_X_PIXEL_ID=res82
NEXT_PUBLIC_X_LISTED_EVENT_ID=tw-res82-resa0
